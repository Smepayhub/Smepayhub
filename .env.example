# ==============================================================================
# SMEHUB Production Environment Configuration (.env)
# Domain: getsmehub.com | VPS IP: 173.214.172.222
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Security Settings
# ------------------------------------------------------------------------------
# Generate a secure 50+ character secret key using:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace_with_a_secure_cryptographic_secret_key

# Set to False in production
DEBUG=False

# Allowed HTTP hostnames and IPs (comma-separated)
ALLOWED_HOSTS=getsmehub.com,www.getsmehub.com,173.214.172.222,localhost,127.0.0.1,web

# Trusted origins for CSRF protection (must include protocol)
CSRF_TRUSTED_ORIGINS=https://getsmehub.com,http://getsmehub.com,https://www.getsmehub.com,http://www.getsmehub.com,https://173.214.172.222,http://173.214.172.222

# CORS configuration
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://getsmehub.com,http://getsmehub.com,https://www.getsmehub.com,http://www.getsmehub.com,https://173.214.172.222,http://173.214.172.222

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
DB_ENGINE=postgres
POSTGRES_DB=smehub_db
POSTGRES_USER=smehub_user
# Generate a strong database password (e.g., openssl rand -hex 24)
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Port & Dokploy Networking Settings
# ------------------------------------------------------------------------------
# Set to 0 to instruct Docker & Dokploy to automatically select available free ports
# on the host VPS, preventing any port collision with other running projects.
FRONTEND_PORT=0
PORT=0
POSTGRES_HOST_PORT=0
REDIS_HOST_PORT=0

# ------------------------------------------------------------------------------
# 4. Stellar Testnet & Platform Configuration
# ------------------------------------------------------------------------------
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_PASSPHRASE=Test SDF Network ; September 2015
USDC_ASSET_CODE=USDC
USDC_ISSUER_ADDRESS=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_EXPERT_BASE_URL=https://stellar.expert/explorer/testnet/tx/
SMEHUB_BASE_CHECKOUT_URL=https://getsmehub.com/checkout/

# Soroban Smart Contract Payment Router
SOROBAN_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# ------------------------------------------------------------------------------
# 5. Automated Bootstrap & Provisioning (Optional)
# ------------------------------------------------------------------------------
# Set to true only if you want demo data seeded on first run into an empty database (defaults to false)
AUTO_POPULATE_DEMO_DATA=false

# Optional: Auto-create Django Admin superuser on container startup
# Set these if you want an admin user provisioned on first launch:
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@getsmehub.com
# DJANGO_SUPERUSER_PASSWORD=replace_with_admin_password
